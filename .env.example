# Copy only when customizing. All paths are local; do not commit .env.
AEGIS_DATA_DIR=.data
AEGIS_LOCAL_MODE=true
# Set LOCAL_MODE=false and a strong generated token before allowing remote clients.
# AEGIS_API_TOKEN=
# AEGIS_API_TOKEN_FILE=/run/secrets/api-token
AEGIS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
AEGIS_OPERATION_TIMEOUT=120
AEGIS_SCHEDULER_INTERVAL=5
AEGIS_KUBE_ENABLED=false
AEGIS_KUBE_NAMESPACE=aegisdr-demo
AEGIS_KUBE_DEPLOYMENT=demo-app
# Enable PostgreSQL demo by setting both variables; no password belongs in this file.
# AEGIS_POSTGRES_ENV=AEGIS_DB_DEMO
# AEGIS_DB_DEMO=postgresql://user:password@127.0.0.1:5432/disposable_database
# For Docker secrets use AEGIS_DB_DEMO_FILE instead.
